{
  "name": "receipt-fold",
  "productName": "发票夹",
  "version": "0.1.1",
  "description": "A private, on-device invoice library",
  "main": "./out/main/index.js",
  "author": "OSpoon",
  "license": "MIT",
  "homepage": "https://github.com/OSpoon/ReceiptFold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSpoon/ReceiptFold.git"
  },
  "bugs": {
    "url": "https://github.com/OSpoon/ReceiptFold/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "ci": "npm run lint -- --quiet && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "bumpp --tag \"v{version}\" --commit \"chore: release v{version}\"",
    "release:patch": "bumpp --release patch --tag \"v{version}\" --commit \"chore: release v{version}\"",
    "release:minor": "bumpp --release minor --tag \"v{version}\" --commit \"chore: release v{version}\"",
    "release:major": "bumpp --release major --tag \"v{version}\" --commit \"chore: release v{version}\""
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.55.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "pinia": "^4.1.0",
    "rapidocr-node": "^0.2.3",
    "reka-ui": "^2.11.0",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "sqlite3-queries": "^2.2.0",
    "tailwind-merge": "^3.7.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "bumpp": "12.3.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
